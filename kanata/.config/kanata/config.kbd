(defcfg
  ;; Thêm dòng này để cho phép Kanata thực thi lệnh cmd
  danger-enable-cmd yes
  
  ;; Các cấu hình defcfg khác của bạn (nếu có)...
  process-unmapped-keys yes
  
)


