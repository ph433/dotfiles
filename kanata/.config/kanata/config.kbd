    (layer-switch workspace_sswitch)
  ))

  a_1 (multi alt 1 (layer-switch mod_nvim))
  a_2 (multi alt 2 (layer-switch mod_nvim))
  a_3 (multi alt 3 (layer-switch mod_nvim))
  a_4 (multi alt 4 (layer-switch mod_nvim))
  a_5 (multi alt 5 (layer-switch mod_nvim))
  a_6 (multi alt 6 (layer-switch mod_nvim))
  a_7 (multi alt 7 (layer-switch mod_nvim))
  a_8 (multi alt 8 (layer-switch mod_nvim))
  a_9 (multi alt 9 (layer-switch mod_nvim))
  a_0 (multi alt 0 (layer-switch mod_nvim))

  c_st (multi lctl lsft tab (layer-switch mod_nvim))
  c_t (multi lctl tab (layer-switch mod_nvim))
)

(defalias
  aa_1 (multi alt 1)
  aa_2 (multi alt 2)
  aa_3 (multi alt 3)
  aa_4 (multi alt 4)
  aa_5 (multi alt 5)
  aa_6 (multi alt 6)
  aa_7 (multi alt 7)
  aa_8 (multi alt 8)
  aa_9 (multi alt 9)
  aa_0 (multi alt 0)

  cc_st (multi lctl lsft tab)
  cc_t (multi lctl tab)
)

(defalias
  lialt (one-shot-press 1000 (layer-toggle like-alt))
)
