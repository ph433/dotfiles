(defalias
  a-hi (multi (macro f a) (layer-switch colemak-dh-ff))
  b-hi (multi (macro f b) (layer-switch colemak-dh-ff))
  c-hi (multi (macro f c) (layer-switch colemak-dh-ff))
  d-hi (multi (macro f d) (layer-switch colemak-dh-ff))
  e-hi (multi (macro f e) (layer-switch colemak-dh-ff))
  f-hi (multi (macro f f) (layer-switch colemak-dh-ff))
  g-hi (multi (macro f g) (layer-switch colemak-dh-ff))
  h-hi (multi (macro f h) (layer-switch colemak-dh-ff))
  i-hi (multi (macro f i) (layer-switch colemak-dh-ff))
  j-hi (multi (macro f j) (layer-switch colemak-dh-ff))
  k-hi (multi (macro f k) (layer-switch colemak-dh-ff))
  l-hi (multi (macro f l) (layer-switch colemak-dh-ff))
  m-hi (multi (macro f m) (layer-switch colemak-dh-ff))
  n-hi (multi (macro f n) (layer-switch colemak-dh-ff))
  o-hi (multi (macro f o) (layer-switch colemak-dh-ff))
  p-hi (multi (macro f p) (layer-switch colemak-dh-ff))
  q-hi (multi (macro f q) (layer-switch colemak-dh-ff))
  r-hi (multi (macro f r) (layer-switch colemak-dh-ff))
  s-hi (multi (macro f s) (layer-switch colemak-dh-ff))
  t-hi (multi (macro f t) (layer-switch colemak-dh-ff))
  u-hi (multi (macro f u) (layer-switch colemak-dh-ff))
  v-hi (multi (macro f v) (layer-switch colemak-dh-ff))
  w-hi (multi (macro f w) (layer-switch colemak-dh-ff))
  x-hi (multi (macro f x) (layer-switch colemak-dh-ff))
  y-hi (multi (macro f y) (layer-switch colemak-dh-ff))
  z-hi (multi (macro f z) (layer-switch colemak-dh-ff))
  ;-hi (multi (macro f ;) (layer-switch colemak-dh-ff))
  '-hi (multi (macro f ') (layer-switch colemak-dh-ff))
  .-hi (multi (macro f .) (layer-switch colemak-dh-ff))
  ,-hi (multi (macro f ,) (layer-switch colemak-dh-ff))
  /-hi (multi (macro f /) (layer-switch colemak-dh-ff))
  
  
  --hi (multi (macro f -) (layer-switch colemak-dh-ff))
  _-hi (multi (macro f S--) (layer-switch colemak-dh-ff))
  
  ;; Number layer aliases
  `-hi  (multi (macro f `)   (layer-switch colemak-dh-ff))
  =-hi  (multi (macro f =)   (layer-switch colemak-dh-ff))
  S+-hi (multi (macro f S-=) (layer-switch colemak-dh-ff))
  \-hi  (multi (macro f \)   (layer-switch colemak-dh-ff))
  [-hi  (multi (macro f [)   (layer-switch colemak-dh-ff))
  ]-hi  (multi (macro f ])   (layer-switch colemak-dh-ff))

  00 0
  01 1
  02 2
  03 3
  04 4
  05 5
  06 6
  07 7
  08 8
  09 9
  
  1-hi  (multi (macro f @01)   (layer-switch colemak-dh-ff))
  2-hi  (multi (macro f @02)   (layer-switch colemak-dh-ff))
  3-hi  (multi (macro f @03)   (layer-switch colemak-dh-ff))
  4-hi  (multi (macro f @04)   (layer-switch colemak-dh-ff))
  5-hi  (multi (macro f @05)   (layer-switch colemak-dh-ff))
  6-hi  (multi (macro f @06)   (layer-switch colemak-dh-ff))
  7-hi  (multi (macro f @07)   (layer-switch colemak-dh-ff))
  8-hi  (multi (macro f @08)   (layer-switch colemak-dh-ff))
  9-hi  (multi (macro f @09)   (layer-switch colemak-dh-ff))
  0-hi  (multi (macro f @00)   (layer-switch colemak-dh-ff))
  
  ;; Shifted symbols aliases
  ~-hi  (multi (macro f S-`) (layer-switch colemak-dh-ff))
  ?-hi  (multi (macro f S-/) (layer-switch colemak-dh-ff))
  |-hi  (multi (macro f S-\) (layer-switch colemak-dh-ff))
  {-hi  (multi (macro f S-[) (layer-switch colemak-dh-ff))
  <-hi  (multi (macro f S-,) (layer-switch colemak-dh-ff))
  >-hi  (multi (macro f S-.) (layer-switch colemak-dh-ff))
  }-hi  (multi (macro f S-]) (layer-switch colemak-dh-ff))

  !-hi  (multi (macro f S-1) (layer-switch colemak-dh-ff))
  @-hi  (multi (macro f S-2) (layer-switch colemak-dh-ff))
  #-hi  (multi (macro f S-3) (layer-switch colemak-dh-ff))
  $-hi  (multi (macro f S-4) (layer-switch colemak-dh-ff))
  %-hi  (multi (macro f S-5) (layer-switch colemak-dh-ff))
  ^-hi  (multi (macro f S-6) (layer-switch colemak-dh-ff))
  &-hi  (multi (macro f S-7) (layer-switch colemak-dh-ff))
  *-hi  (multi (macro f S-8) (layer-switch colemak-dh-ff))
  !a-hi  (multi (macro f S-9) (layer-switch colemak-dh-ff))
  !b-hi  (multi (macro f S-0) (layer-switch colemak-dh-ff))
)

(defalias
  ralt_ (multi (layer-toggle base_colemak-dh) (on-release tap-virtualkey v_ent))
  fhinv (multi (layer-switch colemak-dh-nvim-fhint-switch) (on-release tap-virtualkey v_nvswac))
  cole_ (layer-toggle mod_nvim_colemak-dh)
  cole+ (layer-toggle base_colemak-dh)
  ;; spcc (multi (macro spc) (layer-toggle colemak-dh-active))
  /_ (multi (macro /) (layer-toggle colemak-dh_search_cmd))
  :_ (multi (macro S-;) (layer-toggle colemak-dh_search_cmd))
  bks_ (multi (macro bks) (layer-toggle nvim_delete))
  esca (multi (macro esc) (layer-switch app_open))
  C-/ (multi (macro g c))
  nvtg (multi (layer-toggle mod_nvim) (on-release tap-virtualkey v_ent))
  
  rep-a rpt-any
  repa rpt-any
  rep rpt
)

(defvirtualkeys
  v_ent ent
  v_esc esc
  v_nvswac (switch
    () (layer-switch mod_nvim) break
  )
  
  vk-flush XX
  
  switch_to_modifier_function (switch
    ($has-typed-letter-,) (one-shot-press 1000 (layer-toggle modifier_function)) break
    () XX break
  )
  
  switch_to_function_bare (switch
    ($has-typed-letter-shift) (one-shot-press 1000 (layer-toggle fuction_bare_hold)) break
    () XX break
  )
  
  switch_to_macro_nvim_va (switch
    ($has-typed-letter-k) (one-shot-press 1000 (layer-toggle macro_nvim_va)) break
    () XX break
  )
  
  switch_to_base_colemak-dh (switch
    ($has-typed-letter-ralt) (layer-switch base_colemak-dh) break
    () esc break
  )
  
  switch_to_base (switch
    ($has-typed-letter-ralt) (multi esc (layer-switch base)) break
    () XX break
  )
  
  switch_to_colemak-dh_firefox (switch
    ($has-typed-letter-ralt) (multi (layer-switch colemak-dh_firefox)) break
    () XX break
  )
  
  switch_to_firefox (switch
    ($has-typed-letter-ralt) (multi (layer-switch mod_firefox)) break
    () XX break
  )
  
  switch_to_colemak-dh_nvim (switch
    ($has-typed-letter-ralt) (layer-switch mod_nvim_colemak-dh) break
    () esc break
  )
  
  switch_to_nvim (switch
    ($has-typed-letter-ralt) (multi esc (layer-switch mod_nvim)) break
    () XX break
  )
  
  sign_special_hint (switch
    ($has-typed-letter-lalt) (one-shot-press 1000 (layer-while-held colemak-dh_nvim_fhint_switch_mod_num_shift)) break
    () XX break
  )
  
  sign-special (switch
    ($has-typed-letter-lalt) (one-shot-release-anchor 10000 (layer-while-held mod_num_shift)) break
    () XX break
  )
    
  swt (switch
    ($has-typed-letter-ctl-sft-met-alt) (multi (one-shot-release-anchor 10000 lctl) (one-shot-release-anchor 10000 lsft) (one-shot-release-anchor 10000 lmet) (one-shot-release-anchor 10000 lalt) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    
    ($has-typed-letter-ctl-sft-met) (multi (one-shot-release-anchor 10000 lctl) (one-shot-release-anchor 10000 lsft) (one-shot-release-anchor 10000 lmet) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    ($has-typed-letter-ctl-sft-alt) (multi (one-shot-release-anchor 10000 lctl) (one-shot-release-anchor 10000 lsft) (one-shot-release-anchor 10000 lalt) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    ($has-typed-letter-sft-met-alt) (multi (one-shot-release-anchor 10000 lsft) (one-shot-release-anchor 10000 lmet) (one-shot-release-anchor 10000 lalt) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    ($has-typed-letter-ctl-met-alt) (multi (one-shot-release-anchor 10000 lctl) (one-shot-release-anchor 10000 lmet) (one-shot-release-anchor 10000 lalt) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    
    ($has-typed-letter-ctl-sft) (multi (one-shot-release-anchor 10000 lctl) (one-shot-release-anchor 10000 lsft) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    ($has-typed-letter-ctl-met) (multi (one-shot-release-anchor 10000 lctl) (one-shot-release-anchor 10000 lmet) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    ($has-typed-letter-ctl-alt) (multi (one-shot-release-anchor 10000 lctl) (one-shot-release-anchor 10000 lalt) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    ($has-typed-letter-sft-met) (multi (one-shot-release-anchor 10000 lsft) (one-shot-release-anchor 10000 lmet) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    ($has-typed-letter-sft-alt) (multi (one-shot-release-anchor 10000 lsft) (one-shot-release-anchor 10000 lalt) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    ($has-typed-letter-met-alt) (multi (one-shot-release-anchor 10000 lmet) (one-shot-release-anchor 10000 lalt) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    
    ($has-typed-letter-ctl) (multi (one-shot-release-anchor 10000 lctl) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    ($has-typed-letter-sft) (multi (one-shot-release-anchor 10000 lsft) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    ($has-typed-letter-met) (multi (one-shot-release-anchor 10000 lmet) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    ($has-typed-letter-alt) (multi (one-shot-release-anchor 10000 lalt) (one-shot-release-anchor 10000 (layer-while-held qwert-bare))) break
    
    () XX break
  )
)

(defalias

  flush-hist (on-press tap-virtualkey vk-flush)
  
  jfls (multi j @flush-hist)
  kfls (multi k @flush-hist)
  lfls (multi l @flush-hist)
  ;fls (multi ; @flush-hist)
  
  7- (multi 7 @flush-hist)
  8- (multi 8 @flush-hist)
  9- (multi 9 @flush-hist)
  0- (multi 0 @flush-hist)
  
  f7- (multi f7 @flush-hist)
  f8- (multi f8 @flush-hist)
  f9- (multi f9 @flush-hist)
  f10- (multi f10 @flush-hist)
  
  f1+ (multi (macro f1) (layer-toggle fuction_bare))
  f2+ (multi (macro f2) (layer-toggle fuction_bare))
  f3+ (multi (macro f3) (layer-toggle fuction_bare))
  f4+ (multi (macro f4) (layer-toggle fuction_bare))
  f5+ (multi (macro f5) (layer-toggle fuction_bare))
  f6+ (multi (macro f6) (layer-toggle fuction_bare))
  f7+  (multi (macro f7)  (layer-toggle fuction_bare))
  f8+  (multi (macro f8)  (layer-toggle fuction_bare))
  f9+  (multi (macro f9)  (layer-toggle fuction_bare))
  f10+ (multi (macro f10) (layer-toggle fuction_bare))
  f11+ (multi (macro f11) (layer-toggle fuction_bare))
  f12+ (multi (macro f12) (layer-toggle fuction_bare))
  
  nvv (multi (macro v) (layer-toggle macro_nvim_vi) (on-release tap-virtualkey switch_to_macro_nvim_va))
  
  m_n (multi (layer-toggle modifier_number) (on-release tap-virtualkey switch_to_modifier_function))
  
  ss (multi lsft (layer-toggle base_colemak-dh) (on-release tap-virtualkey switch_to_function_bare))
  
  colnv (multi (macro a) (layer-toggle mod_nvim_colemak-dh) (on-release tap-virtualkey switch_to_colemak-dh_nvim))
  colnvr (multi (macro S-r) (layer-toggle mod_nvim_colemak-dh) (on-release tap-virtualkey switch_to_colemak-dh_nvim))
  colnv- (multi (layer-toggle mod_nvim) (on-release tap-virtualkey switch_to_nvim))
  
  cole (multi (macro a) (layer-toggle base_colemak-dh) (on-release tap-virtualkey switch_to_base_colemak-dh))
  cole- (multi (layer-toggle base) (on-release tap-virtualkey switch_to_base))
  
  colef (multi (layer-toggle colemak-dh_firefox) (on-release tap-virtualkey switch_to_colemak-dh_firefox))
  colef- (multi (layer-toggle mod_firefox) (on-release tap-virtualkey switch_to_firefox))
  
  numt (multi (layer-toggle mod_num) (on-release tap-virtualkey sign-special))
  numttg (multi (layer-toggle colemak-dh_nvim_fhint_switch_num) (on-release tap-virtualkey sign_special_hint))
  nssw (layer-toggle mod_num_shift)
  fbsw (layer-toggle fuction_bare)
  nusw (layer-toggle mod_num)
  
  a_v-sw (multi (layer-toggle like-alt) (on-release tap-virtualkey swt))
  c_v-sw (multi (layer-toggle like-ctl) (on-release tap-virtualkey swt))
  s_v-sw (multi (layer-toggle like-sft) (on-release tap-virtualkey swt))
  m_v-sw (multi (layer-toggle like-met) (on-release tap-virtualkey swt))
  
  m-a (macro a)
  m-b (macro b)
  m-c (macro c)
  m-d (macro d)
  m-e (macro e)
  m-f (macro f)
  m-g (macro g)
  m-h (macro h)
  m-i (macro i)
  m-j (macro j)
  m-k (macro k)
  m-l (macro l)
  m-m (macro m)
  m-n (macro n)
  m-o (macro o)
  m-p (macro p)
  m-q (macro q)
  m-r (macro r)
  m-s (macro s)
  m-t (macro t)
  m-u (macro u)
  m-v (macro v)
  m-w (macro w)
  m-x (macro x)
  m-y (macro y)
  m-z (macro z)
  m-, (macro ,)
  m-. (macro .)
  m-/ (macro /)
  m-spc (macro spc)
)

(deflayer colemak-dh_bare
  _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _
  del     q       w       f       p       b       _       _       j       l       u       y       ;       /               _       _       _       _
  bks     a       r       s       t       g       _       _       m       n       e       i       o       _               _       _       _       _
  @ss     x       c       d       v       z       _       _       k       h       ,       .       @ss                     _       _       _       _
  _       _       _       _       _       _       _       _       @m_n    _       _       _               _               _       _       _
  _       _       XX                        spc                   XX      _                       _       _       _       _               _
)

(deflayer qwert-bare
  _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       @m-q    @m-w    @m-e    @m-r    @m-t    _       _       @m-y    @m-u    @m-i    @m-o    @m-p    _               _       _       _       _
  _       @m-a    @m-s    @m-d    @m-f    @m-g    _       _       @m-h    @jfls   @kfls   @lfls   @;fls   @rep-a          _       _       _       _
  _       @m-z    @m-x    @m-c    @m-v    @m-b    _       _       @m-n    @m-m    @m-,    @m-.    @m-/                    _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _               _               _       _       _
  _       _       @fbsw                    @m-spc                 _       _                       _       _       _       _               _
)

(deflayer number-bare
  _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       `       -       =       S-=     /       _       _       \       [       S-9     S-0     ]       _               _       _       _       _
  _       1       2       3       4       5       _       _       6       @7-     @8-     @9-     @0-     _               _       _       _       _
  _       _       _       ;       _       _       _       _       '       _       ,       .       _                       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _               _               _       _       _
  _       _       _                          _                    _       _                       _       _       _       _               _
)

(deflayer fuction_bare_hold
  _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       @f11+   _       _       _       _       _       _       @f12+   _       _       _               _       _       _       _
  _       @f1+    @f2+    @f3+    @f4+    @f5+    _       _       @f6+    @f7+    @f8+    @f9+    @f10+   _               _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _                       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _               _               _       _       _
  _       _       _                          _                    _       _                       _       _       _       _               _
)

(deflayer fuction_bare
  _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       f11     _       _       _       _       _       _       f12     _       _       _               _       _       _       _
  _       f1      f2      f3      f4      f5      _       _       f6      @f7-    @f8-    @f9-    @f10-   _               _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _                       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _               _               _       _       _
  _       _       _                          _                    _       _                       _       _       _       _               _
)

(defvar

  has-typed-letter-k (or (input-history real k 2))
  has-typed-letter-, (or (input-history real , 2))
  has-typed-letter-shift (or (input-history real caps 2)
                             (input-history real ent 2))
  
  has-typed-letter-lalt (or (input-history real lalt 2))
  
  has-typed-letter-ralt (or (input-history real ralt 2))
  
  has-typed-letter-[ (or (input-history real [ 2))
  
  has-typed-letter-ctl (or (input-history real o 2))
  has-typed-letter-sft (or (input-history real p 2))
  has-typed-letter-met (or (input-history real [ 2))
  has-typed-letter-alt (or (input-history real ] 2))
  
  has-typed-letter-ctl-sft (or
      (and (input-history real o 2) (input-history real p 3))
      (and (input-history real p 2) (input-history real o 3))
    )
  has-typed-letter-ctl-met (or
      (and (input-history real o 2) (input-history real [ 3))
      (and (input-history real [ 2) (input-history real o 3))
    )
  has-typed-letter-ctl-alt (or
      (and (input-history real o 2) (input-history real ] 3))
      (and (input-history real ] 2) (input-history real o 3))
    )
  has-typed-letter-sft-met (or
      (and (input-history real [ 2) (input-history real p 3))
      (and (input-history real p 2) (input-history real [ 3))
    )
  has-typed-letter-sft-alt (or
      (and (input-history real ] 2) (input-history real p 3))
      (and (input-history real p 2) (input-history real ] 3))
    )
  has-typed-letter-met-alt (or
      (and (input-history real ] 2) (input-history real [ 3))
      (and (input-history real [ 2) (input-history real ] 3))
    )
  
  has-typed-letter-ctl-sft-met (or
      ;; 1. j -> k -> l
      (and (input-history real [ 2) (input-history real p 3) (input-history real o 4))
      ;; 2. j -> l -> k
      (and (input-history real p 2) (input-history real [ 3) (input-history real o 4))
      ;; 3. k -> j -> l
      (and (input-history real [ 2) (input-history real o 3) (input-history real p 4))
      ;; 4. k -> l -> j
      (and (input-history real o 2) (input-history real [ 3) (input-history real p 4))
      ;; 5. l -> j -> k
      (and (input-history real p 2) (input-history real o 3) (input-history real [ 4))
      ;; 6. l -> k -> j
      (and (input-history real o 2) (input-history real p 3) (input-history real [ 4))
    )
  has-typed-letter-ctl-sft-alt (or
      ;; 1. j -> k -> ;
      (and (input-history real ] 2) (input-history real p 3) (input-history real o 4))
      ;; 2. j -> ; -> k
      (and (input-history real p 2) (input-history real ] 3) (input-history real o 4))
      ;; 3. k -> j -> ;
      (and (input-history real ] 2) (input-history real o 3) (input-history real p 4))
      ;; 4. k -> ; -> j
      (and (input-history real o 2) (input-history real ] 3) (input-history real p 4))
      ;; 5. ; -> j -> k
      (and (input-history real p 2) (input-history real o 3) (input-history real ] 4))
      ;; 6. ; -> k -> j
      (and (input-history real o 2) (input-history real p 3) (input-history real ] 4))
    )
  has-typed-letter-sft-met-alt (or
      ;; 1. k -> l -> ;
      (and (input-history real ] 2) (input-history real [ 3) (input-history real p 4))
      ;; 2. k -> ; -> l
      (and (input-history real [ 2) (input-history real ] 3) (input-history real p 4))
      ;; 3. l -> k -> ;
      (and (input-history real ] 2) (input-history real p 3) (input-history real [ 4))
      ;; 4. l -> ; -> k
      (and (input-history real p 2) (input-history real ] 3) (input-history real [ 4))
      ;; 5. ; -> k -> l
      (and (input-history real [ 2) (input-history real p 3) (input-history real ] 4))
      ;; 6. ; -> l -> k
      (and (input-history real p 2) (input-history real [ 3) (input-history real ] 4))
    )
  has-typed-letter-ctl-met-alt (or
      ;; 1. j -> l -> ;
      (and (input-history real ] 2) (input-history real [ 3) (input-history real o 4))
      ;; 2. j -> ; -> l
      (and (input-history real [ 2) (input-history real ] 3) (input-history real o 4))
      ;; 3. l -> j -> ;
      (and (input-history real ] 2) (input-history real o 3) (input-history real [ 4))
      ;; 4. l -> ; -> j
      (and (input-history real o 2) (input-history real ] 3) (input-history real [ 4))
      ;; 5. ; -> j -> l
      (and (input-history real [ 2) (input-history real o 3) (input-history real ] 4))
      ;; 6. ; -> l -> j
      (and (input-history real o 2) (input-history real [ 3) (input-history real ] 4))
    )
    
  has-typed-letter-ctl-sft-met-alt (or
      ;; Bắt đầu bằng ; ở slot 2
      (and (input-history real ] 2) (input-history real [ 3) (input-history real p 4) (input-history real o 5))
      (and (input-history real ] 2) (input-history real [ 3) (input-history real o 4) (input-history real p 5))
      (and (input-history real ] 2) (input-history real p 3) (input-history real [ 4) (input-history real o 5))
      (and (input-history real ] 2) (input-history real p 3) (input-history real o 4) (input-history real [ 5))
      (and (input-history real ] 2) (input-history real o 3) (input-history real [ 4) (input-history real p 5))
      (and (input-history real ] 2) (input-history real o 3) (input-history real p 4) (input-history real [ 5))
      
      ;; Bắt đầu bằng l ở slot 2
      (and (input-history real [ 2) (input-history real ] 3) (input-history real p 4) (input-history real o 5))
      (and (input-history real [ 2) (input-history real ] 3) (input-history real o 4) (input-history real p 5))
      (and (input-history real [ 2) (input-history real p 3) (input-history real ] 4) (input-history real o 5))
      (and (input-history real [ 2) (input-history real p 3) (input-history real o 4) (input-history real ] 5))
      (and (input-history real [ 2) (input-history real o 3) (input-history real ] 4) (input-history real p 5))
      (and (input-history real [ 2) (input-history real o 3) (input-history real p 4) (input-history real ] 5))
      
      ;; Bắt đầu bằng k ở slot 2
      (and (input-history real p 2) (input-history real ] 3) (input-history real [ 4) (input-history real o 5))
      (and (input-history real p 2) (input-history real ] 3) (input-history real o 4) (input-history real [ 5))
      (and (input-history real p 2) (input-history real [ 3) (input-history real ] 4) (input-history real o 5))
      (and (input-history real p 2) (input-history real [ 3) (input-history real o 4) (input-history real ] 5))
      (and (input-history real p 2) (input-history real o 3) (input-history real ] 4) (input-history real [ 5))
      (and (input-history real p 2) (input-history real o 3) (input-history real [ 4) (input-history real ] 5))
      
      ;; Bắt đầu bằng j ở slot 2
      (and (input-history real o 2) (input-history real ] 3) (input-history real [ 4) (input-history real p 5))
      (and (input-history real o 2) (input-history real ] 3) (input-history real p 4) (input-history real [ 5))
      (and (input-history real o 2) (input-history real [ 3) (input-history real ] 4) (input-history real p 5))
      (and (input-history real o 2) (input-history real [ 3) (input-history real p 4) (input-history real ] 5))
      (and (input-history real o 2) (input-history real p 3) (input-history real ] 4) (input-history real [ 5))
      (and (input-history real o 2) (input-history real p 3) (input-history real [ 4) (input-history real ] 5))
    )
    
  has-typed-' (and (input-history real ' 1)
               or $has-typed-letter)
)
