  swa (one-shot-press 1000 (layer-toggle like-sft-win-alt))
  cwa (one-shot-press 1000 (layer-toggle like-ctl-win-alt))

  cswa (one-shot-press 1000 (layer-toggle like-ctl-sft-win-alt))

)

