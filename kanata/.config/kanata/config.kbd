(defalias
  nvsw (layer-switch mod_nvim)
  nvswtg (layer-toggle mod_nvim)
  
  mou (layer-toggle mouse-mode)
  
  ;; nvswa (layer-switch mod_nvim-active)
  nvswa (multi (layer-switch mod_nvim-active) ent)
  nvswac (layer-toggle mod_nvim-active)
  colosw (layer-switch colemak-dh)
  nvswff (layer-switch mod_firefox)
  nvswft (one-shot-press 1000 (layer-toggle mod_firefox-temp))
  colef (layer-switch colemak-dh-firefox)
  coleft (one-shot-press 1000 (layer-toggle colemak-dh-firefox-temp))
  nvswt (one-shot-press 1000 (layer-toggle mod_nvim-temp))
  nvswt! (one-shot-press 1000 (layer-toggle mod_nvim-temp-!c))
  nvswat (one-shot-press 1000 (layer-toggle mod_nvim-active-temp))
  numt (one-shot-press 1000 (layer-toggle mod_num))
  colet (one-shot-press 1000 (layer-toggle colemak-dh-temp))
  colnv (one-shot-press 1000 (layer-toggle colemak-dh-nvim-temp))
  f1-12 (layer-toggle fuction-bare)
)

(defalias
  sropt (one-shot-press 1000 (layer-toggle search-opt))
  ;; nvv (layer-toggle macro-nvim-visual)
  nvv (multi (macro v) (layer-toggle macro-nvim-visual))
  fir (layer-toggle macro-firefox)
)

(defalias
  del_w (macro d w)
  osl_d (multi bspc (one-shot 1000 (layer-toggle nvim_delete)))
  tabe (multi (layer-switch mod_nvim-active) esc)
  tabee (multi (layer-switch colemak-dh-active) esc)
  taba (multi (layer-switch colemak-dh-active) a)
  tabi (multi (layer-switch colemak-dh-active) i)
  tabii (multi (layer-switch colemak-dh-active) S-r)
  
  staba (multi (layer-switch colemak-dh-active) shft a)
  stabi (multi (layer-switch colemak-dh-active) shft i)
  f13 (multi (layer-switch colemak-dh-qute-active) ins)
  gi (multi (layer-switch colemak-dh-qute-active) (macro g i 100 ins))
  qutetg (layer-toggle colemak-dh-qute-active)
  tabqe (multi (layer-switch mod_qutebrowser) esc)

  fd (layer-toggle colemak-dh-ff)
  srchf (multi lctl f (layer-switch colemak-dh-search)) 
  cmd (multi lsft ; (layer-switch colemak-dh-cmd))
)

(defalias
  ss (layer-toggle colemak-dh-shift)
  ns (one-shot-press 1000 (layer-toggle mod_num-shift-temp))

  ;; sc (one-shot 2000 lctl) ;; Sticky Ctrl
  ;; sa (one-shot 2000 lalt) ;; Sticky Alt
  ;; sw (one-shot 2000 lmet) ;; Sticky Win (Super)
)

(defalias
  pra2t (one-shot-press 1000 (layer-toggle pre-right-arrow2-temp))
  pra2tt (one-shot-press 1000 (layer-toggle pre-right-arrow2-temp-fromnv))
  pra2 (layer-switch pre-right-arrow2)
)

(defalias
  ctab (multi lctl tab)
  cstab (multi lctl lsft tab)
)

(defalias
  viw (macro i w)
  viW (macro i S-w)
  S-v (macro esc S-v)
  vi1 (macro i S-9)
  vi2 (macro i [)
  vi3 (macro i S-[)
  vi4 (macro i ')
  vi5 (macro i S-')
  cgn (macro c g n)
  gg (multi (macro g g) (layer-switch mod_nvim-active))
  vv (multi (macro v v))
  g_ (multi (macro g S--))
)

(defalias
  ;; Tổ hợp: Win (meta) + Alt + Shift + Mũi tên
  wasl (multi lsft lalt h)
  wasr (multi lsft lalt l)
  wasu (multi lsft lalt k)
  wasd (multi lsft lalt j)

  ;; Tổ hợp: Win (meta) + Alt + Shift + Mũi tên
  swwast (one-shot-press 1000 (layer-toggle createwindows-temp))
  swwas (layer-switch createwindows)
  wwasl (multi lctl lalt h)
  wwasr (multi lctl lalt l)
  wwasu (multi lctl lalt k)
  wwasd (multi lctl lalt j)
)

(defalias
  m1 (multi lsft lalt m) ;; @onl (only)
  x1 (multi lsft lalt x) ;; @cls (close)
  e1 (multi lsft lalt e) ;; @equ (equalize)
  r1 (multi lsft lalt r) ;; @rot (rotate)
  onl (multi lsft lalt p)
)

