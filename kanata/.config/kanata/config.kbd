(defvar

  has-typed-letter-ctl (or (input-history real j 2))
  has-typed-letter-sft (or (input-history real k 2))
  has-typed-letter-met (or (input-history real l 2))
  has-typed-letter-alt (or (input-history real ; 2))
  
  has-typed-letter-ctl-sft (or
      (and (input-history real j 2) (input-history real k 3))
      (and (input-history real k 2) (input-history real j 3))
    )
  has-typed-letter-ctl-met (or
      (and (input-history real j 2) (input-history real l 3))
      (and (input-history real l 2) (input-history real j 3))
    )
  has-typed-letter-ctl-alt (or
      (and (input-history real j 2) (input-history real ; 3))
      (and (input-history real ; 2) (input-history real j 3))
    )
  has-typed-letter-sft-met (or
      (and (input-history real l 2) (input-history real k 3))
      (and (input-history real k 2) (input-history real l 3))
    )
  has-typed-letter-sft-alt (or
      (and (input-history real ; 2) (input-history real k 3))
      (and (input-history real k 2) (input-history real ; 3))
    )
  has-typed-letter-met-alt (or
      (and (input-history real ; 2) (input-history real l 3))
      (and (input-history real l 2) (input-history real ; 3))
    )
  
  has-typed-letter-ctl-sft-met (or
      ;; 1. j -> k -> l
      (and (input-history real l 2) (input-history real k 3) (input-history real j 4))
      ;; 2. j -> l -> k
      (and (input-history real k 2) (input-history real l 3) (input-history real j 4))
      ;; 3. k -> j -> l
      (and (input-history real l 2) (input-history real j 3) (input-history real k 4))
      ;; 4. k -> l -> j
      (and (input-history real j 2) (input-history real l 3) (input-history real k 4))
      ;; 5. l -> j -> k
      (and (input-history real k 2) (input-history real j 3) (input-history real l 4))
      ;; 6. l -> k -> j
      (and (input-history real j 2) (input-history real k 3) (input-history real l 4))
    )
  has-typed-letter-ctl-sft-alt (or
      ;; 1. j -> k -> ;
      (and (input-history real ; 2) (input-history real k 3) (input-history real j 4))
      ;; 2. j -> ; -> k
      (and (input-history real k 2) (input-history real ; 3) (input-history real j 4))
      ;; 3. k -> j -> ;
      (and (input-history real ; 2) (input-history real j 3) (input-history real k 4))
      ;; 4. k -> ; -> j
      (and (input-history real j 2) (input-history real ; 3) (input-history real k 4))
      ;; 5. ; -> j -> k
      (and (input-history real k 2) (input-history real j 3) (input-history real ; 4))
      ;; 6. ; -> k -> j
      (and (input-history real j 2) (input-history real k 3) (input-history real ; 4))
    )
  has-typed-letter-sft-met-alt (or
      ;; 1. k -> l -> ;
      (and (input-history real ; 2) (input-history real l 3) (input-history real k 4))
      ;; 2. k -> ; -> l
      (and (input-history real l 2) (input-history real ; 3) (input-history real k 4))
      ;; 3. l -> k -> ;
      (and (input-history real ; 2) (input-history real k 3) (input-history real l 4))
      ;; 4. l -> ; -> k
      (and (input-history real k 2) (input-history real ; 3) (input-history real l 4))
      ;; 5. ; -> k -> l
      (and (input-history real l 2) (input-history real k 3) (input-history real ; 4))
      ;; 6. ; -> l -> k
      (and (input-history real k 2) (input-history real l 3) (input-history real ; 4))
    )
  has-typed-letter-ctl-met-alt (or
      ;; 1. j -> l -> ;
      (and (input-history real ; 2) (input-history real l 3) (input-history real j 4))
      ;; 2. j -> ; -> l
      (and (input-history real l 2) (input-history real ; 3) (input-history real j 4))
      ;; 3. l -> j -> ;
      (and (input-history real ; 2) (input-history real j 3) (input-history real l 4))
      ;; 4. l -> ; -> j
      (and (input-history real j 2) (input-history real ; 3) (input-history real l 4))
      ;; 5. ; -> j -> l
      (and (input-history real l 2) (input-history real j 3) (input-history real ; 4))
      ;; 6. ; -> l -> j
      (and (input-history real j 2) (input-history real l 3) (input-history real ; 4))
    )
    
  has-typed-letter-ctl-sft-met-alt (or
      ;; Bắt đầu bằng ; ở slot 2
      (and (input-history real ; 2) (input-history real l 3) (input-history real k 4) (input-history real j 5))
      (and (input-history real ; 2) (input-history real l 3) (input-history real j 4) (input-history real k 5))
      (and (input-history real ; 2) (input-history real k 3) (input-history real l 4) (input-history real j 5))
      (and (input-history real ; 2) (input-history real k 3) (input-history real j 4) (input-history real l 5))
      (and (input-history real ; 2) (input-history real j 3) (input-history real l 4) (input-history real k 5))
      (and (input-history real ; 2) (input-history real j 3) (input-history real k 4) (input-history real l 5))
      
      ;; Bắt đầu bằng l ở slot 2
      (and (input-history real l 2) (input-history real ; 3) (input-history real k 4) (input-history real j 5))
      (and (input-history real l 2) (input-history real ; 3) (input-history real j 4) (input-history real k 5))
      (and (input-history real l 2) (input-history real k 3) (input-history real ; 4) (input-history real j 5))
      (and (input-history real l 2) (input-history real k 3) (input-history real j 4) (input-history real ; 5))
      (and (input-history real l 2) (input-history real j 3) (input-history real ; 4) (input-history real k 5))
      (and (input-history real l 2) (input-history real j 3) (input-history real k 4) (input-history real ; 5))
      
      ;; Bắt đầu bằng k ở slot 2
      (and (input-history real k 2) (input-history real ; 3) (input-history real l 4) (input-history real j 5))
      (and (input-history real k 2) (input-history real ; 3) (input-history real j 4) (input-history real l 5))
      (and (input-history real k 2) (input-history real l 3) (input-history real ; 4) (input-history real j 5))
      (and (input-history real k 2) (input-history real l 3) (input-history real j 4) (input-history real ; 5))
      (and (input-history real k 2) (input-history real j 3) (input-history real ; 4) (input-history real l 5))
      (and (input-history real k 2) (input-history real j 3) (input-history real l 4) (input-history real ; 5))
      
      ;; Bắt đầu bằng j ở slot 2
      (and (input-history real j 2) (input-history real ; 3) (input-history real l 4) (input-history real k 5))
      (and (input-history real j 2) (input-history real ; 3) (input-history real k 4) (input-history real l 5))
      (and (input-history real j 2) (input-history real l 3) (input-history real ; 4) (input-history real k 5))
      (and (input-history real j 2) (input-history real l 3) (input-history real k 4) (input-history real ; 5))
      (and (input-history real j 2) (input-history real k 3) (input-history real ; 4) (input-history real l 5))
      (and (input-history real j 2) (input-history real k 3) (input-history real l 4) (input-history real ; 5))
    )
    
  has-typed-' (and (input-history real ' 1)
               or $has-typed-letter)
)
