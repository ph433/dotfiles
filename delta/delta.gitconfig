[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    features = calochortus-lyallii
    true-color = always
    stat = false
    ; stat-style = "#00FFFF"

[color "diff"]
    meta = "#00FFFF" bold               
    frag = "#FF0087" bold               
    new = "#00FF00" bold                
    old = "#FF0000" bold

[color]
    ui = true

[color "decorate"]
    HEAD = "bold #FF0000"
    branch = "bold #00FF00"
    remoteBranch = "bold #FF00FF"
    tag = "bold #FFFF00"

[color "status"]
    # Cấu hình màu đường dẫn file cho git status
    added = "#00FF00" bold
    changed = "#FF0000" bold
    untracked = "#FF0000" bold
